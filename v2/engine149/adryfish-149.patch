+bool Element::ShouldSkipClientRectsOffset() const {
+  if (!GetLayoutObject() || !GetLayoutObject()->Style()) {
+    return false;
+  }
+
+  const ComputedStyle& style = *GetLayoutObject()->Style();
+
+  // 检查是否为绝对定位
